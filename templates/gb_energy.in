# =============================================================================
# BTO-GB-v2 : 0 K relaxation for grain-boundary energies.
# Same protocol for the bicrystal AND for its no-GB reference cell (same box, same N,
# grain-1 orientation everywhere), so gamma = (E_bi - E_ref) / (2 A) uses a matched
# bulk reference instead of a hard-coded energy.
# Relaxation = damped-MD quench (fixed cell, then damped aniso NPT at ~0 K).
# 'minimize'/'box/relax' are NOT used: with born/coul/wolf/cs they blow up when shells sit
# almost on their cores, and box/relax stalls because the ENERGY is discontinuous at the 9 A Born cutoff
# unless pair_modify shift yes is set (found 2026-11-01; now in the force field). The damped NPT works on forces.
#   -var data <file>  -var ff <forcefield>  [-var nq 3000] [-var nb 8000]
# Output: "GBE_RESULT pe lx ly lz press fmax" + relaxed.data
# =============================================================================
variable        nq index 3000
variable        nb index 8000
units           metal
dimension       3
boundary        p p p
atom_style      full
timestep        0.0004
fix             csinfo all property/atom i_CSID
read_data       ${data} fix csinfo NULL CS-Info
include         ${ff}
group           cores  type 1 2 3
group           shells type 4 5 6
compute         CSequ all temp/cs cores shells

thermo          500
thermo_style    custom step c_CSequ pe fmax press pxx pyy pzz lx ly lz
thermo_modify   flush yes

velocity        all create 1.0 4928459 dist gaussian temp CSequ
fix             q  all nve/limit 0.02
fix             vq all viscous 0.5
run             ${nq}
unfix           q
unfix           vq
fix             qb all npt temp 1.0 1.0 0.1 aniso 0.0 0.0 1.0
fix_modify      qb temp CSequ
fix             vq all viscous 0.2
run             ${nb}
unfix           qb
unfix           vq
run             0

write_data      relaxed.data
write_dump      all custom relaxed.dump id type x y z modify sort id
print           "GBE_RESULT $(pe:%.8f) $(lx:%.8f) $(ly:%.8f) $(lz:%.8f) $(press:%.2f) $(fmax:%.3e)"
